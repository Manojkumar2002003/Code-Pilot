# Application
APP_NAME=CodePilot API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/codepilot.db

# LLM Foundation Settings
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_TIMEOUT_SECONDS=60.0
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096

# Intelligent Routing & Failover
LLM_FAILOVER_ENABLED=true
LLM_PROVIDER_PRIORITY=gemini,openrouter,groq,nvidia_nim,ollama_cloud
LLM_MAX_FAILOVER_ATTEMPTS=3
LLM_TOTAL_REQUEST_DEADLINE_SECONDS=120.0
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0

# Provider: Google Gemini
LLM_GEMINI_API_KEY=
LLM_GEMINI_DEFAULT_MODEL=gemini-2.0-flash
LLM_GEMINI_ENABLED=true

# Provider: OpenRouter
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
LLM_OPENROUTER_ENABLED=true

# Provider: NVIDIA NIM
LLM_NVIDIA_NIM_API_KEY=
LLM_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
LLM_NVIDIA_NIM_ENABLED=true

# Provider: Groq
LLM_GROQ_API_KEY=
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
LLM_GROQ_ENABLED=true

# Provider: Ollama Cloud (Hosted cloud inference service — not local Ollama)
LLM_OLLAMA_CLOUD_API_KEY=
LLM_OLLAMA_CLOUD_BASE_URL=https://api.ollama.com
LLM_OLLAMA_CLOUD_DEFAULT_MODEL=llama3.1
LLM_OLLAMA_CLOUD_ENABLED=true

# Frontend API configuration
# Create a frontend/.env file if you need a custom API base URL.
VITE_API_BASE_URL=http://localhost:8000

